# LOOP — example environment configuration.
# Copy to .env and adjust. NEVER commit the real .env file.

APP_ENV=development
APP_NAME=LOOP
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL (must match docker-compose.yml when using Docker)
POSTGRES_USER=loop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loop
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://loop:change-me@localhost:5432/loop

# Auth — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Public base URL of the API (used by future external clients)
API_URL=http://localhost:8000

# Optional: separate database used by the automated test suite.
# If unset, tests fall back to an isolated SQLite database.
TEST_DATABASE_URL=

# --- Demo mode -------------------------------------------------------------
# Keep this false on the real instance. It is only true on the public demo
# deployment, which runs against its own database containing fictional data.
DEMO_MODE=false
# Password for the seeded demo accounts. Required only when DEMO_MODE=true.
DEMO_PASSWORD=
